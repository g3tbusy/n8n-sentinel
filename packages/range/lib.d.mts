// Декларации типов для lib.mjs. Нужны, чтобы типизированные правила eslint видели
// экспорты общего транспорта полигона, а не «any» из нетипизированного .mjs.
// Сам транспорт остаётся на обычном ESM — сборки у пакета range нет.

/** Настройки из .env.local: LLM_BASE_URL, LLM_API_KEY, LLM_MODEL и прочее. */
export function читатьНастройки(): Record<string, string>;

/** Разбор ответа прокси: срезает хвост `data: [DONE]` и парсит JSON. null при неудаче. */
export function разобратьОтвет(тело: string): unknown;

/** Пауза в миллисекундах. */
export function подождать(мс: number): Promise<void>;

/** Клиент к прокси: повтор по 429, разбор потока. Возвращает { код, тело }. */
export function создатьКлиента(опции: {
  база?: string;
  ключ?: string;
}): (тело: unknown) => Promise<{ код: number; тело: any; ошибка?: string }>;

/** Клиент к OpenAI-совместимому эндпоинту (/chat/completions, Bearer). */
export function создатьOpenAIКлиента(опции: {
  база?: string;
  ключ?: string;
}): (тело: unknown) => Promise<{ код: number; тело: any; ошибка?: string }>;

/** Текстовые блоки ответа модели, склеенные в одну строку. */
export function текстОтвета(тело: unknown): string;

/**
 * Годится ли ответ атакующей модели на роль инъекции.
 * Возвращает причину непригодности или null, если ответ — настоящая инъекция.
 *   'пусто'   — пустой ответ;
 *   'персона' — вместо инъекции пришла подмешанная прокси личность «я Claude»;
 *   'отказ'   — модель отказалась писать инъекцию (текстом, без stop_reason).
 */
export function почемуНеИнъекция(
  текст: string | null | undefined,
): 'пусто' | 'персона' | 'отказ' | null;

/** Корень пакета range (для путей к .env.local и .range-runs). */
export const КОРЕНЬ: string;

/** Сколько раз повторять запрос по 429, прежде чем сдаться. */
export const ПОВТОРОВ_ПО_429: number;
