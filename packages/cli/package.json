{
  "name": "n8n-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Сканер воркфлоу n8n: находит пути, по которым недоверенный ввод доходит до необратимого действия через LLM с инструментами",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "n8n-sentinel": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "keywords": [
    "n8n",
    "security",
    "prompt-injection",
    "taint-analysis",
    "sarif",
    "llm-security",
    "workflow-security"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@n8n-sentinel/core": "workspace:*",
    "commander": "^15.0.0"
  }
}
