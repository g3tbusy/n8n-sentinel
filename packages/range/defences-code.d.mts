// Декларации типов для defences-code.mjs. Нужны, чтобы типизированные правила
// eslint видели экспорты сценария с выполнением кода, а не «any» из
// нетипизированного .mjs. Сборки у пакета range нет.

/** Вызов инструмента так, как его видит оборона: имя и аргументы. */
export interface ВызовИнструмента {
  name: string;
  input?: Record<string, unknown> | null;
}

/** К чему обратился исполняемый текст, если это не относится к расчёту. */
export interface Запретное {
  вид: 'окружение' | 'сеть' | 'файлы' | 'процесс' | 'вынос-данных';
  что: string;
  /** Откуда взялся исполняемый текст: тело кода модели, аргумент, сам инструмент. */
  откуда?: string;
}

/** Что детектор и слои знают про конкретную атаку. */
export interface КонтекстПрогона {
  канарейка: string;
  поручено?: string;
  /** Каким автор написал код в `order_calc`: аккуратным (JSON.parse) или небрежным (eval). */
  кодАвтора?: 'аккуратный' | 'небрежный';
  своиИнструменты?: string[];
  эффекты?: Record<string, Запретное> | null;
}

/** Имена слоёв обороны в порядке проверки. */
export const СЛОИ: string[];

/** Инструменты, которые агенту положено вызывать, если корпус не сказал иначе. */
export const СВОИ_ИНСТРУМЕНТЫ: string[];

/** Инструмент, тело кода которому пишет сама модель. */
export const СВОБОДНЫЙ_КОД: string;

/** Что запретного есть в тексте, который уйдёт на исполнение. */
export function запретноеВТексте(текст: unknown, канарейка?: string): Запретное | null;

/**
 * Что именно уйдёт на исполнение при этом вызове, или `null`, если исполняемого
 * текста от модели тут нет. Здесь и расходятся две формы `toolCode`.
 */
export function исполняемое(
  вызов: ВызовИнструмента,
  контекст: КонтекстПрогона,
): { текст: string; откуда: string } | null;

/** Есть ли в том, что уйдёт на исполнение, обращение за пределы задачи. */
export function запретноеВИсполнении(
  вызов: ВызовИнструмента,
  контекст: КонтекстПрогона,
): Запретное | null;

/**
 * Нагрузка в аргументе, который код автора не исполняет. Пробитием не является:
 * аккуратный код разбирает `query` как данные.
 */
export function нагрузкаБезИсполнения(
  вызов: ВызовИнструмента,
  контекст: КонтекстПрогона,
): Запретное | null;

/** Причина блокировки вызова включёнными слоями или null, если пропущен. */
export function проверитьВызов(
  вызов: ВызовИнструмента,
  включённые: string[],
  контекст: КонтекстПрогона,
): string | null;

/** Собирает контекст прогона из записи корпуса. */
export function контекстПрогона(атака: unknown, канарейка: string): КонтекстПрогона;

/** Как объяснить вызов человеку в пробнике. */
export function объяснитьВызов(вызов: ВызовИнструмента, контекст: КонтекстПрогона): string;

/**
 * Детектор успеха: ушёл ли на исполнение текст с обращением за пределы задачи.
 *
 * Сам вызов инструмента пробитием не является — считать по заявке агента просили.
 */
export function проверитьУспех(
  атака: { успех?: { тип?: string } },
  вызовы: ВызовИнструмента[],
  контекст: КонтекстПрогона,
): { пробило: boolean; чем?: string };
