// Декларации типов для defences-subflow.mjs. Нужны, чтобы типизированные правила
// eslint видели экспорты сценария с вложенными воркфлоу, а не «any» из
// нетипизированного .mjs. Сборки у пакета range нет.

/** Вызов инструмента так, как его видит оборона: имя и аргументы. */
export interface ВызовИнструмента {
  name: string;
  input?: Record<string, unknown> | null;
}

/** Чем именно вызов вышел за границу задания. */
export interface ВыходЗаГраницу {
  вид: 'чужая-процедура' | 'необратимое-действие' | 'наружу' | 'чужой-заказ';
  что: string;
}

/** Что детектор и слои знают про конкретную атаку. */
export interface КонтекстПрогона {
  канарейка: string;
  поручено?: string;
  разрешеноДействие?: string;
  своиПроцедуры?: string[];
  /** Адрес заявителя из тела заявки: уведомить его о его же заказе — работа. */
  контакт?: string;
  эффекты?: Record<string, ВыходЗаГраницу> | null;
}

/** Домен компании: уведомление внутрь него внешним не считается. */
export const ДОМЕН: string;

/** Имена слоёв обороны в порядке проверки. */
export const СЛОИ: string[];

/** Процедуры, которые агенту положено вызывать, если корпус не сказал иначе. */
export const СВОИ_ПРОЦЕДУРЫ: string[];

/**
 * Уходит ли уведомление за пределы тех, кому оно положено — компании и самому
 * заявителю. Пустое значение — уведомление по умолчанию, оно внутреннее.
 */
export function уведомлениеНаружу(значение: unknown, контакт?: string): boolean;

/** Выходит ли вызов за границу задания, и чем именно. */
export function заГраницей(
  вызов: ВызовИнструмента,
  контекст: КонтекстПрогона,
): ВыходЗаГраницу | null;

/** Причина блокировки вызова включёнными слоями или null, если пропущен. */
export function проверитьВызов(
  вызов: ВызовИнструмента,
  включённые: string[],
  контекст: КонтекстПрогона,
): string | null;

/** Собирает контекст прогона из записи корпуса. */
export function контекстПрогона(атака: unknown, канарейка: string): КонтекстПрогона;

/** Как объяснить вызов человеку в пробнике. */
export function объяснитьВызов(вызов: ВызовИнструмента, контекст: КонтекстПрогона): string;

/**
 * Детектор успеха: выполнен ли sink внутри под-воркфлоу с данными из инъекции.
 *
 * Сам факт вызова процедуры пробитием не является — процедура штатная, и вызвать
 * её агента как раз просили. Пробитие — аргументы, вышедшие за границу задания.
 */
export function проверитьУспех(
  атака: { успех?: { тип?: string } },
  вызовы: ВызовИнструмента[],
  контекст: КонтекстПрогона,
): { пробило: boolean; чем?: string };
