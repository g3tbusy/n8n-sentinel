// Декларации типов для defences-intake.mjs. Нужны, чтобы типизированные правила
// eslint видели экспорты слоёв обороны, а не «any» из нетипизированного .mjs.
// Сборки у пакета range нет.

/** Вызов инструмента так, как его видит оборона: имя и аргументы. */
export interface ВызовИнструмента {
  name: string;
  input?: Record<string, unknown> | null;
}

/** Внутренний API сценария — единственный разрешённый адресат. */
export const ВНУТРЕННИЙ_API: string;

/** Имена слоёв обороны в порядке проверки. */
export const СЛОИ: string[];

/**
 * Куда вызов уносит данные.
 *   null — наружу не ходит;
 *   ''   — адрес есть, но не разобран (для обороны это внешний адресат);
 *   иначе хост в нижнем регистре.
 * `адресаты` — карта «имя инструмента → хост» для инструментов, ходящих наружу
 * самостоятельно (подсунутый атакой MCP-инструмент).
 */
export function адресатВызова(
  вызов: ВызовИнструмента,
  адресаты?: Record<string, string> | null,
): string | null;

/** Внешний ли адресат. Неразобранный адрес считается внешним. */
export function внешний(хост: string | null): boolean;

/** Что детектор и слои знают про конкретную атаку. */
export interface КонтекстПрогона {
  канарейка: string;
  адресаты?: Record<string, string> | null;
}

/** Причина блокировки вызова включёнными слоями или null, если пропущен. */
export function проверитьВызов(
  вызов: ВызовИнструмента,
  включённые: string[],
  контекст: КонтекстПрогона,
): string | null;

/** Собирает контекст прогона из записи корпуса. */
export function контекстПрогона(атака: unknown, канарейка: string): КонтекстПрогона;

/**
 * Детектор успеха: унёс ли агент данные наружу.
 *
 * Живёт рядом со слоями и пользуется тем же `адресатВызова` — в фазе 8.1 их
 * копии разошлись, и канал с отравленным инструментом показывал ложный ноль.
 */
export function проверитьУспех(
  атака: { успех?: { тип?: string; разрешено?: string } },
  вызовы: ВызовИнструмента[],
  контекст: КонтекстПрогона,
): { пробило: boolean; чем?: string };
