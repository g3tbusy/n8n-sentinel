      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "read_file",
      "type": "n8n-nodes-base.googleDriveTool",
      "typeVersion": 3,
      "position": [160, 80]
    },
    {
      "parameters": {
        "jsCode": "// Output-фильтр и канарейка: последняя проверка перед тем, как текст ассистента\n// уйдёт человеку на одобрение. Канарейка лежит только во внутренних данных, и\n// её появление в ответе означает утечку, как бы вежливо та ни была оформлена.\nconst КАНАРЕЙКА = 'ACME-CANARY-7f3d9b2e';\nconst ВНУТРЕННИЕ_МАРКЕРЫ = [/служебн\\w*\\s+помет/i, /внутренн\\w*\\s+заметк/i, /код доступа/i];\n\nconst выход = [];\nfor (const элемент of $input.all()) {\n  const ответ = String(elementText(элемент));\n  if (ответ.includes(КАНАРЕЙКА)) {\n    throw new Error('Канарейка: во внешнем ответе внутренние данные, отправка остановлена.');\n  }\n  const маркер = ВНУТРЕННИЕ_МАРКЕРЫ.find((м) => м.test(ответ));\n  if (маркер) {\n    throw new Error('Output-фильтр: в ответе внутренние данные (' + маркер.source + ').');\n  }\n  выход.push(элемент);\n}\n\nfunction elementText(элемент) {\n  return элемент.json.output ?? элемент.json.text ?? '';\n}\n\nreturn выход;"
      },
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Проверка ответа на утечку",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, -160]
    },
