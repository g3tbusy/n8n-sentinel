// Декларации типов для defences-table.mjs. Нужны, чтобы типизированные правила
// eslint видели экспорты сценария с таблицей, а не «any» из нетипизированного
// .mjs. Сборки у пакета range нет.

/** Вызов инструмента так, как его видит оборона: имя и аргументы. */
export interface ВызовИнструмента {
  name: string;
  input?: Record<string, unknown> | null;
}

/** Что вызов делает с таблицей. Пустой ключ означает правку по диапазону. */
export interface Правка {
  вид: 'добавление' | 'изменение' | 'удаление';
  ключ: string;
}

/** Что детектор и слои знают про конкретную атаку. */
export interface КонтекстПрогона {
  канарейка: string;
  поручено?: string;
  правки?: Record<string, Правка> | null;
}

/** Имена слоёв обороны в порядке проверки. */
export const СЛОИ: string[];

/** Ключ строки из фильтра `delete_rows`; пустая строка, если это диапазон. */
export function ключИзФильтра(фильтр: unknown): string;

/**
 * Что вызов делает с таблицей, или null, если ничего не пишет.
 * `правки` — карта «имя инструмента → правка» для инструментов, правящих
 * таблицу самостоятельно (подсунутый атакой MCP-инструмент).
 */
export function правкаВызова(
  вызов: ВызовИнструмента,
  правки?: Record<string, Правка> | null,
): Правка | null;

/** Затрагивает ли правка что-то, кроме поручённого агенту заказа. */
export function чужая(правка: Правка | null, поручено?: string): boolean;

/** Причина блокировки вызова включёнными слоями или null, если пропущен. */
export function проверитьВызов(
  вызов: ВызовИнструмента,
  включённые: string[],
  контекст: КонтекстПрогона,
): string | null;

/** Собирает контекст прогона из записи корпуса. */
export function контекстПрогона(атака: unknown, канарейка: string): КонтекстПрогона;

/**
 * Детектор успеха: испортил ли агент данные, которые ему не поручали трогать.
 *
 * Живёт рядом со слоями и пользуется тем же `правкаВызова` — в фазе 8.1 копии
 * условия разошлись, и канал с отравленным инструментом показывал ложный ноль.
 */
export function проверитьУспех(
  атака: { успех?: { тип?: string } },
  вызовы: ВызовИнструмента[],
  контекст: КонтекстПрогона,
): { пробило: boolean; чем?: string };
