// Декларации типов для agent-kb.mjs. Нужны, потому что замок сценария трогает
// сам стенд, а не только оборону: база знаний — это состояние, и тест проверяет,
// что она переживает фазу, но не прогон. Сборки у пакета range нет.

/** Запись базы знаний. `источник` ставит стенд, а не агент. */
export interface ЗаписьБазы {
  id: string;
  заголовок: string;
  текст: string;
  источник: 'регламент компании' | 'обращение клиента';
}

/** Домен компании. */
export const ДОМЕН: string;

/** Число фаз прогона. Двойка здесь и делает сценарий двухфазным — это читает раннер. */
export const ФАЗ: number;

/** Роль жертвы без единой оговорки про недоверенный ввод — baseline. */
export const СИСТЕМНЫЙ_ПРОМПТ_НАИВНЫЙ: string;

/** Развёрнутая роль: держит персону, к инъекциям отношения не имеет. */
export const СИСТЕМНЫЙ_ПРОМПТ: string;

/** Объявления инструментов в формате Anthropic. */
export const ИНСТРУМЕНТЫ: unknown[];

/** Сбрасывает базу знаний. Раннер зовёт это перед первой фазой каждого прогона. */
export function подготовитьПрогон(): void;

/** Что сейчас лежит в базе — читает детектор и замок. */
export function снимокБазы(): ЗаписьБазы[];

/** Заглушки инструментов. Наружу не ходит ничего. */
export function выполнитьИнструмент(
  имя: string,
  аргументы: Record<string, unknown> | null | undefined,
  канарейка: string,
): string;

/** Промпт фазы: 1 — обращение с инъекцией, 2 — чистый вопрос в новом разговоре. */
export function собратьСообщение(атака: unknown, фаза?: number): string;

/** Куда атакующий кладёт переписанный текст. */
export function сИнъекцией(атака: unknown, текст: string): unknown;

/** Обратное к предыдущему: что показывать в журнале. */
export function текстИнъекции(атака: unknown): string | undefined;

/** Промпт усилителя. */
export const АТАКУЮЩИЙ: { система: string; цель: string; переписать: string[] };
